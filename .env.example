# Browserbase — cloud browser provider
BROWSERBASE_API_KEY=bb_live__your_key_here
BROWSERBASE_PROJECT_ID=your_project_id_here

# OpenAI — used by Stagehand to understand pages and decide actions
OPENAI_API_KEY=sk-your_key_here

# TopstepX credentials
TOPSTEPX_USERNAME=autoverse.pro@gmail.com
TOPSTEPX_PASSWORD=your_password_here

# TradingView credentials
TRADINGVIEW_EMAIL=your_email_here
TRADINGVIEW_PASSWORD=your_password_here

# Security — n8n must send this header on every request
# Generate any random string e.g: openssl rand -hex 32
AGENT_SECRET=your_random_secret_here

# Railway sets this automatically — do not set manually
# PORT=3000
